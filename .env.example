# Public client metadata
VITE_APP_NAME=Aba Ghalia & Amina

# Server-only Vercel authentication secrets.
# Never expose these with a VITE_ prefix and never commit real values.
# Generate APP_PASSWORD_HASH with: pnpm hash-password
APP_PASSWORD_HASH=scrypt$replace_with_generated_salt$replace_with_generated_digest
SESSION_SECRET=replace_with_a_long_random_secret

# Optional future integrations
# VITE_API_BASE_URL=
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
